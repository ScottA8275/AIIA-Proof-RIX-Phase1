cff-version: 1.2.0

message: "If you use this reproducibility package, please cite it using the metadata below."
title: "Proof RIX Phase I Reproducibility Package"
version: "1.0"
date-released: "2026-05-22"
license: "MIT"
abstract: >
  Proof RIX Phase I establishes a reproducible recursive transport-topology
  framework for biological organization. The package reproduces canonical
  Milestones 7–10 figures and metrics, including recursive capacity efficiency,
  fragmentation boundaries, comparative transport regimes, predictive topology,
  causal intervention analysis, and recursive transport phase mapping.

authors:
  - family-names: "Allbright"
    given-names: "Scott"

  - name: "AIIA Technologies Research Group"

keywords:
  - recursive transport topology
  - recursive indexing
  - biological representation geometry
  - fragmentation boundaries
  - transport phase regions
  - recursive compression
  - admissibility-constrained transport

repository-code: "https://github.com/YOUR_ORG/proof_rix_phase1_repro"
